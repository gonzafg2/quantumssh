# EditorConfig: https://editorconfig.org
# Top-level config; do not look further up the tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown line breaks: preserve trailing whitespace (used for hard breaks).
trim_trailing_whitespace = false
indent_size = 2

[*.{toml,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab
